# Copy to .env on the server (or enter the same names under Plesk -> Node.js -> Custom environment
# variables). Never commit the real file. Lines marked REQUIRED stop the server when missing.

NODE_ENV=production

# REQUIRED. MySQL 8.0+; use a dedicated, initially empty database.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Only when the database is shared with another application: every table of this application is
# then created and used as <prefix><name> (for example wa_users) and other tables are never
# touched. Choose it before the first db:setup and never change it afterwards.
# DB_TABLE_PREFIX=wa_

# The application creates and updates its own tables when it starts. Set this to "off" to do it
# yourself with "npm run db:setup".
# DB_AUTO_SETUP=off

# First administrator: created once at start-up if no account has this email. The password needs
# 12+ characters with upper and lower case, a digit and a symbol. Remove both lines after signing in.
# ADMIN_EMAIL=you@your-domain
# ADMIN_PASSWORD=

# REQUIRED. Two different random values, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRET signs sign-in sessions. DATA_ENCRYPTION_KEY protects sensitive profile fields:
# keep a copy somewhere safe, because data encrypted with it cannot be read without it.
AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# REQUIRED. The public address, with https and no trailing slash.
APP_URL=https://app.wisdomcourse.com.et

# Where client photos, voice notes and videos are kept. Use a folder outside the application
# folder so redeploys do not touch it, and include it in backups.
UPLOAD_DIR=/var/www/vhosts/example.et/private/uploads

# Email for password resets and verification codes (a mailbox from your hosting panel works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ethiopian Wisdom Atlas <no-reply@example.et>"

# Online payments (Chapa: cards, telebirr, CBE Birr, M-Pesa). Leave empty to record payments by hand.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Telegram sign-in, notifications and password resets (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp updates and replies through Meta's WhatsApp Business Cloud API (optional; see docs/MESSAGING.md).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The number people message, in international format.
WHATSAPP_BUSINESS_NUMBER=+251900000000
# Meta app secret (signs incoming webhooks) and a random value you also enter when registering the webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# An approved template with two body variables, needed to reach people outside WhatsApp's 24-hour window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Optional tuning
# DB_POOL_MAX=10
# NCBI_API_KEY=
