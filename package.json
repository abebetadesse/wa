{
  "name": "ethio-wellness-platform",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5500",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --loader ts-node/esm src/lib/db/seed.ts",
    "literature:dryrun": "npx tsx src/lib/literature/test-dryrun.ts",
    "literature:sync": "npx tsx -e \"import('./src/lib/literature/literatureFetcher.ts').then(m => m.getLiteratureFetcher().triggerManual())\"",
    "test": "npx --no-install tsx --test src/tests/evaluation.test.mjs src/tests/case-workflow.test.mjs src/tests/auth.test.mjs src/tests/mechanism.test.mjs src/tests/multimodal-constitution.test.mjs src/tests/astrology-numerology-cultural.test.mjs src/tests/knowledge-retrieval.test.mjs src/tests/rbac-auth.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.475.0",
    "next": "15.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.13.3",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3"
  }
}
