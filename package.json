{
  "name": "ethio-wellness-platform",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"try { require('@next/env').loadEnvConfig(process.cwd(), false, { info(){}, error(){} }); if (process.env.DATABASE_URL) { console.log('[build] Pre-compiled release; running database setup...'); require('child_process').execSync('node scripts/migrate.mjs --production && node scripts/setup-reference.cjs', { stdio: 'inherit' }); } else { console.log('[build] Pre-compiled release ready.'); } } catch (e) { console.warn('[build] Note:', e.message); }\"",
    "start": "node app.js",
    "db:migrate": "node scripts/migrate.mjs --production",
    "db:status": "node scripts/migrate.mjs --production --status",
    "db:reference": "node scripts/setup-reference.cjs",
    "db:setup": "node scripts/migrate.mjs --production && node scripts/setup-reference.cjs",
    "admin:create": "node scripts/create-admin.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.475.0",
    "mysql2": "^3.24.5",
    "next": "^15.5.27",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "xml2js": "^0.6.2",
    "zod": "3.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.29"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
